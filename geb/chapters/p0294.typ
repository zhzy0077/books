  #h(2em)（2）\<P∧～P\>#h(12.5em)前提\
  #h(2em)（3）P#h(12.5em)分隔\
  #h(2em)（4）～P#h(12.5em)分隔\
  #h(2em)（5）\[#h(12.5em)推入\
  #h(2em)（6）～Q#h(12.5em)前提\
  #h(2em)（7）P#h(12.5em)把第 3 行搬入\
  #h(2em)（8）～～P#h(12.5em)双弯号\
  #h(2em)（9）\]#h(12.5em)弹出\
  #h(2em)（10）\<～Q⊳～～P\>#h(12.5em)幻想\
  #h(2em)（11）\<～P⊳Q\>#h(12.5em)易位\
  #h(2em)（12）Q#h(12.5em)分离（4,11 行）\
  #h(2em)（13）\]#h(12.5em)弹出\
  #h(2em)（14）\<\<P∧～P\>⊳Q\>#h(12.5em)幻想\
]

